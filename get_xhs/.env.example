# 小红书Cookie字符串（从浏览器F12控制台复制）
# 格式: "a1=xxxx; web_session=xxxx; webId=xxxx; ..."
COOKIE_STRING=

# 请求间隔随机范围（秒）
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5

# 最大评论获取数（0=不限）
MAX_COMMENTS=0

# 输出目录
OUTPUT_DIR=output

# Playwright浏览器状态持久化文件
STORAGE_STATE_FILE=.storage_state.json

# 代理设置（可选）
# PROXY=http://127.0.0.1:7890
